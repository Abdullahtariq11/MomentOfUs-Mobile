<ContentPage
    x:Class="MomentOfUs.App.Views.JournalDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Journal Detail"
    BackgroundColor="{Binding PageBackgroundColor}">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <VerticalStackLayout Spacing="12">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="{Binding Journal.Title}"
                    TextColor="#374151" />
                <Image
                    HeightRequest="24"
                    Source="edit_icon.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
            </HorizontalStackLayout>

            <Label
                FontSize="14"
                Text="{Binding Journal.CreatedAt, StringFormat='🗓️ Created: {0:MMM dd, yyyy}'}"
                TextColor="#6B7280" />

            <!--  Color Theme Picker  -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label
                    FontSize="16"
                    Text="🎨 Theme"
                    TextColor="#4B5563" />
                <Picker
                    Title="Background Color"
                    ItemsSource="{Binding AvailableColors}"
                    SelectedItem="{Binding SelectedColor}"
                    TextColor="Black"
                    WidthRequest="200" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!--  Body  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,20,0,20" Spacing="30">

                <!--  Add/Edit Entry  -->
                <Frame
                    Padding="16"
                    BackgroundColor="#FFFFFF"
                    CornerRadius="12"
                    HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="➕ Add or Edit Entry"
                            TextColor="#4B5563" />

                        <Editor
                            AutoSize="TextChanges"
                            BackgroundColor="#F3F4F6"
                            FontSize="14"
                            HeightRequest="100"
                            Placeholder="Write your thoughts here..."
                            Text="{Binding CurrentEntry.Content}"
                            TextColor="#374151" />

                        <HorizontalStackLayout Spacing="12">
                            <Label
                                FontSize="16"
                                Text="Mood"
                                TextColor="#4B5563"
                                VerticalOptions="Center" />

                            <Picker
                                Title="Mood"
                                ItemsSource="{Binding MoodEmojis}"
                                SelectedIndex="{Binding CurrentEntry.Mood}"
                                TextColor="Black"
                                WidthRequest="120" />

                            <Button
                                BackgroundColor="#FB923C"
                                Command="{Binding AddOrUpdateEntryCommand}"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                Text="Save"
                                TextColor="White" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!--  Entries  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="📒 Entries"
                    TextColor="#4B5563" />

                <CollectionView ItemsSource="{Binding JournalEntries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem
                                            BackgroundColor="#3B82F6"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditEntryCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Edit" />
                                        <SwipeItem
                                            BackgroundColor="#EF4444"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteEntryCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="Delete" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Frame
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    BackgroundColor="#FFFFFF"
                                    BorderColor="#E5E7EB"
                                    CornerRadius="12"
                                    HasShadow="True">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout>
                                            <Label
                                                FontSize="20"
                                                Text="{Binding MoodEmoji}"
                                                TextColor="#4B5563"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="14"
                                                HorizontalOptions="StartAndExpand"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Content}"
                                                TextColor="#374151" />
                                        </HorizontalStackLayout>
                                        <Label
                                            FontSize="12"
                                            HorizontalOptions="End"
                                            Text="{Binding CreatedAt, StringFormat='🕒 {0:MMM d, yyyy}'}"
                                            TextColor="#9CA3AF" />
                                    </VerticalStackLayout>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!--  Footer  -->
        <Label
            Grid.Row="2"
            Margin="0,10,0,0"
            FontSize="12"
            HorizontalTextAlignment="Center"
            Text="© Abdullah Tariq — All rights reserved"
            TextColor="#6B7280" />
    </Grid>
</ContentPage>
