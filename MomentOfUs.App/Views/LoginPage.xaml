<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="MomentOfUs.App.Views.LoginPage"
             Title="LoginPage"
             Background="#FEEBC8"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="30" Spacing="20">
        <!-- Logo Animation -->
        <skia:SKLottieView
            x:Name="LottieAnimation"
            Source="logo_animation.json"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            IsAnimationEnabled="True"
            RepeatMode="Restart"
            RepeatCount="2"
            HeightRequest="120"
            WidthRequest="120" />

        <!-- App Name -->
        <Label
            Text="Moment Of Us"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            FontSize="50"
            TextColor="Black"
            FontAttributes="Bold"
            FontFamily="PlaylistScript"/>

        <!-- Username Entry -->
        <Frame Padding="10" Margin="0,20,0,0" CornerRadius="15" HasShadow="True"
               BackgroundColor="White" BorderColor="#FDBA74" MinimumWidthRequest="300">
            <Entry Placeholder="Enter your username"
                   Keyboard="Email"
                   ClearButtonVisibility="WhileEditing"
                   TextColor="#4B5563"
                   FontSize="17"/>
        </Frame>

        <!-- Password Entry + Forgot Password -->
        <VerticalStackLayout>
            <Frame Padding="10" Margin="0,10,0,0" CornerRadius="15" HasShadow="True"
                   BackgroundColor="White" BorderColor="#FDBA74" MinimumWidthRequest="300">
                <Entry Placeholder="Enter your Password"
                       IsPassword="True"
                       ClearButtonVisibility="WhileEditing"
                       TextColor="#4B5563"
                       FontSize="17"/>
            </Frame>

            <!-- Forgot Password -->
            <Label
                Text="Forgot Password?"
                TextColor="#9B2C2C"
                FontSize="15"
                FontAttributes="Bold"
                HorizontalOptions="End"
                Margin="0,5,10,0"/>
        </VerticalStackLayout>

        <!-- Login Button -->
        <Button
            Margin="0,25,0,0"
            Text="Login"
            BackgroundColor="#FDBA74"
            FontSize="17"
            FontAttributes="Bold"
            HeightRequest="50"
            CornerRadius="25"/>

        <!-- Signup Link -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="10">
            <Label
                Text="Don't have an account?"
                TextColor="#4B5563"
                FontSize="15"/>
            <Label
                Text="Signup"
                TextColor="#9B2C2C"
                FontSize="15"
                FontAttributes="Bold"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
