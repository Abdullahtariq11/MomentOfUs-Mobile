<ContentPage
    x:Class="MomentOfUs.App.Views.JournalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Journals"
    BackgroundColor="#FEEBC8">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto">

        <!--  Page Title  -->
        <Label
            Grid.Row="0"
            Margin="0,10,0,10"
            FontAttributes="Bold"
            FontFamily="PlaylistScript"
            FontSize="28"
            HorizontalOptions="Center"
            Text="📓 My Journals"
            TextColor="#4B5563" />

        <!--  Main Content Scroll  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="30">

                <!--  Create New Journal Button  -->
                <Button
                    Padding="20,10"
                    BackgroundColor="#FB923C"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="55"
                    HorizontalOptions="FillAndExpand"
                    Text="+ Create a New Journal"
                    TextColor="White" />

                <!--  Your Journals  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="📝 Your Journals"
                    TextColor="#4B5563" />

                <CollectionView
                    Margin="0,0,0,10"
                    ItemsSource="{Binding Journals}"
                    SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="You haven't created any journals yet." TextColor="Red" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="15" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Frame
                                Padding="15"
                                BackgroundColor="White"
                                BorderColor="#FDBA74"
                                CornerRadius="15"
                                HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.JournalTappedCommand}" CommandParameter="{Binding Id}" />
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding Title}"
                                        TextColor="#4B5563" />
                                    <Label
                                        FontSize="13"
                                        Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}'}"
                                        TextColor="#9B2C2C" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--  Shared Journals  -->
                <Label
                    Margin="0,20,0,0"
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="🤝 Shared With You"
                    TextColor="#4B5563" />

                <CollectionView
                    Margin="0,0,0,10"
                    ItemsSource="{Binding SharedJournals}"
                    SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="You haven't created any journals yet."
                            TextColor="Red" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="15" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                Padding="15"
                                BackgroundColor="White"
                                BorderColor="#FDBA74"
                                CornerRadius="15"
                                HasShadow="True">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding Title}"
                                        TextColor="#4B5563" />
                                    <Label
                                        FontSize="13"
                                        Text="{Binding PermissionText}"
                                        TextColor="#6B7280" />
                                    <Label
                                        FontSize="13"
                                        Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, yyyy}'}"
                                        TextColor="#9B2C2C" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!--  Footer  -->
        <Label
            Grid.Row="2"
            Margin="0,10,0,10"
            FontSize="12"
            HorizontalTextAlignment="Center"
            Text="© Abdullah Tariq — All rights reserved"
            TextColor="#4B5563" />

    </Grid>

</ContentPage>
